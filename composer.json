{
    "name": "fahmiazizhakim/laravel-auto-rollback",
    "description": "Wrap every HTTP request in a database transaction and roll it back afterwards -- for demo, staging, development and dry-run environments.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "database",
        "transaction",
        "rollback",
        "dry-run",
        "demo"
    ],
    "authors": [
        {
            "name": "Fahmi Aziz Hakim",
            "homepage": "https://github.com/FahmiAzizHakim"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "FahmiAzizHakim\\LaravelAutoRollback\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FahmiAzizHakim\\LaravelAutoRollback\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FahmiAzizHakim\\LaravelAutoRollback\\AutoRollbackServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
